+//! Evaluating formula-based conditional formatting rules.
+
+use duke_sheets_core::{CellAddress, CellRange, Workbook};
+use duke_sheets_formula::{evaluate, parse_formula, EvaluationContext, FormulaValue};
+use duke_sheets_xlsx::reader::translate_shared_formula;
+
+/// The cells in `ranges` where a conditional-format formula holds.
+///
+/// As in Excel, the formula is written for the top-left cell of the first
+/// range; for every other cell its relative references are shifted by that
+/// cell's offset. A cell matches when the formula returns TRUE or a non-zero
+/// number. Cells outside the sheet's used range are not checked.
+pub fn conditional_formula_matches(
+    workbook: &Workbook,
+    sheet_index: usize,
+    formula: &str,
+    ranges: &[CellRange],
+) -> Vec<CellAddress> {
+    let (Some(first), Some(used)) = (
+        ranges.first(),
+        workbook.worksheet(sheet_index).and_then(|sheet| sheet.used_range()),
+    ) else {
+        return Vec::new();
+    };
+    let formula = format!("={}", formula.trim().trim_start_matches('='));
+    let anchor = first.start.to_a1_string();
+    let mut matches = Vec::new();
+    for range in ranges {
+        for row in range.start.row.max(used.start.row)..=range.end.row.min(used.end.row) {
+            for col in range.start.col.max(used.start.col)..=range.end.col.min(used.end.col) {
+                let cell = CellAddress::new(row, col);
+                let shifted = translate_shared_formula(&formula, &anchor, &cell.to_a1_string());
+                let Ok(expression) = parse_formula(&shifted) else {
+                    continue;
+                };
+                let context = EvaluationContext::new(Some(workbook), sheet_index, row, col);
+                if evaluate(&expression, &context).is_ok_and(|value| is_true(&value)) {
+                    matches.push(cell);
+                }
+            }
+        }
+    }
+    matches
+}
+
+fn is_true(value: &FormulaValue) -> bool {
+    match value {
+        FormulaValue::Boolean(value) => *value,
+        FormulaValue::Number(value) => *value != 0.0,
+        FormulaValue::Array { data, .. } => data.first().and_then(|row| row.first()).is_some_and(is_true),
+        _ => false,
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn workbook() -> Workbook {
+        let mut workbook = Workbook::new();
+        let sheet = workbook.worksheet_mut(0).unwrap();
+        for (row, value) in [5.0, 15.0, 25.0].into_iter().enumerate() {
+            sheet.set_cell_value_at(row as u32, 0, value).unwrap();
+        }
+        sheet.set_cell_value("C1", 10.0).unwrap();
+        sheet.set_cell_value("B2", "x").unwrap();
+        workbook
+    }
+
+    fn matches(formula: &str, range: &str) -> Vec<String> {
+        conditional_formula_matches(&workbook(), 0, formula, &[CellRange::parse(range).unwrap()])
+            .iter()
+            .map(CellAddress::to_a1_string)
+            .collect()
+    }
+
+    #[test]
+    fn shifts_relative_references_and_keeps_absolute_ones() {
+        assert_eq!(matches("A1>$C$1", "A1:A3"), ["A2", "A3"]);
+    }
+
+    #[test]
+    fn shifts_columns_as_well_as_rows() {
+        assert_eq!(matches("LEN(TRIM(A1))=0", "A1:B3"), ["B1", "B3"]);
+    }
+
+    #[test]
+    fn treats_non_zero_numbers_as_true_and_errors_as_false() {
+        assert_eq!(matches("A1-5", "A1:A3"), ["A2", "A3"]);
+        assert_eq!(matches("1/0", "A1:A3"), Vec::<String>::new());
+    }
+
+    #[test]
+    fn checks_only_the_used_range() {
+        assert_eq!(matches("TRUE", "A1:A1048576"), ["A1", "A2", "A3"]);
+    }
+}
